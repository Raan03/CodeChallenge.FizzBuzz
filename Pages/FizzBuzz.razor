@page "/fizzbuzz"
<div class="container-xxl my-3">
    <h3>Solve the FizzBuzz Problem</h3>
    <p>Enter the values for Fizz, Buzz, and the stopping point to generate the FizzBuzz sequence.</p>
    <EditForm Model="fizzBuzzModel" OnValidSubmit="generateFizzBuzzResults">
        <DataAnnotationsValidator />
        <div class="border border-secondary-subtle rounder p-4">
            <div class="row row-cols-1 row-cols-md-3 align-items-start">
                <div class="col">
                    <label for="fizzValue" class="form-label">Fizz Value</label>
                    <InputNumber id="fizzValue" class="form-control" @bind-Value="fizzBuzzModel.FizzValue" aria-describedby="fizzHelp" aria-label="Fizz Value" placeholder="Fizz Value" />
                    <div id="fizzHelp" class="form-text text-muted">
                        Replaces multiples of this number with 'fizz'
                    </div>
                    <ValidationMessage For="@(() => fizzBuzzModel.FizzValue)" />
                </div>
                <div class="col">
                    <label for="buzzValue" class="form-label">Buzz Value</label>
                    <InputNumber id="buzzValue" class="form-control" @bind-Value="fizzBuzzModel.BuzzValue" aria-describedby="buzzHelp" aria-label="Buss Value" placeholder="Buzz Value" />
                    <div id="buzzHelp" class="form-text text-muted">
                        Replaces multiples of this number with 'buzz'
                        <ValidationMessage For="@(() => fizzBuzzModel.BuzzValue)" />

                    </div>
                </div>
                <div class="col">
                    <label for="stopValue" class="form-label">Stop Value</label>
                    <InputNumber id="stopValue" class="form-control" @bind-Value="fizzBuzzModel.StopValue" aria-describedby="stopHelp" aria-label="Stop Value" placeholder="Stop Value" />
                    <div id="stopHelp" class="form-text text-muted">
                        What is the stop value?
                    </div>
                    <ValidationMessage For="@(() => fizzBuzzModel.StopValue)" />
                </div>
            </div>
            <div class="row">
                <div class="col text-end mt-2">
                    <button type="submit" class="btn btn-primary" aria-label="Generate FizzBuss result">
                        Generate
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
    @*
    @foreach (var item in fizzBuzzResults)
    {
        <div>@item</div>
    }
    @firstTestResult
    @secondTestResult
    @debugInfo
    *@
</div>
@code {
    private FizzBuzzModel fizzBuzzModel = new FizzBuzzModel();
    private List<string> fizzBuzzResults = new List<string>();

    // inline testing for given scenario's
    // move to bunit?
    private bool firstTestResult = false;
    private bool secondTestResult = false;
    private string debugInfo = string.Empty;

    private void firstTest()
    {
        fizzBuzzModel.FizzValue = 3;
        fizzBuzzModel.BuzzValue = 5;
        fizzBuzzModel.StopValue = 100;

        generateFizzBuzzResults();

        firstTestResult = true;
        var expectedOutput = new List<string> { "1", "2", "Fizz", "4", "Buzz", "Fizz", "7", "8", "Fizz", "Buzz", "11", "Fizz", "13", "14", "FizzBuzz" };

        for(var i = 0; i < expectedOutput.Count; i++)
        {
            var expectedOutputString = expectedOutput.ElementAt(i);
            var fizzBuzzResultString = fizzBuzzResults.ElementAt(i);

            if (expectedOutputString != fizzBuzzResultString)
            {
                firstTestResult = false;
                debugInfo = $"Test failed at index {i}. Expected: {expectedOutputString}, but got: {fizzBuzzResultString}";
                break;
            }
        }
    }
    protected override void OnInitialized()
    {
        base.OnInitialized();
        //firstTest();
        //secondTest();
    }

    private void secondTest()
    {
        fizzBuzzModel.FizzValue = 4;
        fizzBuzzModel.BuzzValue = 7;
        fizzBuzzModel.StopValue = 50;

        generateFizzBuzzResults();

        secondTestResult = true;
        var expectedOutput = new List<string> { "1", "2", "3", "Fizz", "5", "6", "Buzz", "Fizz", "9", "10", "11", "Fizz", "13", "Buzz", "15", "Fizz", "17", "18", "19", "Fizz", "Buzz", "22", "23", "Fizz", "25", "26", "27", "FizzBuzz" };

        for (var i = 0; i < expectedOutput.Count; i++)
        {
            var expectedOutputString = expectedOutput.ElementAt(i);
            var fizzBuzzResultString = fizzBuzzResults.ElementAt(i);

            if (expectedOutputString != fizzBuzzResultString)
            {
                secondTestResult = false;
                debugInfo = $"Test2 failed at index {i}. Expected: {expectedOutputString}, but got: {fizzBuzzResultString}";

                break;
            }
        }
    }

    private void generateFizzBuzzResults()
    {
        fizzBuzzResults.Clear();

        // loop over all the numbers between 1 and stopvalue.
        // any number divisible by a specified FizzValue will be replaced with "Fizz," 
        // any number divisible by a specified BuzzValue with "Buzz," 
        // and any number divisible by both will be replaced with "FizzBuzz."
        // Test Case 1 (FizzValue = 3, BuzzValue = 5, StopValue = 100):
        // Output: 1, 2, Fizz, 4, Buzz, Fizz, 7, 8, Fizz, Buzz, 11, Fizz, 13, 14, FizzBuzz, … up to 100.
        // Example Test Case 2 (FizzValue = 4, BuzzValue = 7, StopValue = 50):
        // Output: 1, 2, 3, Fizz, 5, 6, Buzz, Fizz, 9, 10, 11, Fizz, 13, Buzz, 15, Fizz, 17, 18, 19, Fizz, Buzz, 22, 23, Fizz, 25, 26, 27, FizzBuzz, …up to 50.
        for (int i = 1; i <= fizzBuzzModel.StopValue; i++)
        {
            string result = i.ToString();

            if (i % fizzBuzzModel.FizzValue == 0 && i % fizzBuzzModel.BuzzValue == 0)
            {
                result = "FizzBuzz";
            }
            else if (i % fizzBuzzModel.FizzValue == 0)
            {
                result = "Fizz";
            }
            else if (i % fizzBuzzModel.BuzzValue == 0)
            {
                result = "Buzz";
            }

            fizzBuzzResults.Add(result);
        }
    }
}
